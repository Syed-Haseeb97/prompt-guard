# Copy to `.env` and fill in the keys you need.
# prompt-guard reads API keys from the environment — never from the config file.

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Generic HTTP gateway
GATEWAY_TOKEN=

# Local Ollama / LM Studio (usually no key required, but the config may require one)
OLLAMA_API_KEY=ollama

# Variables referenced by `{{placeholders}}` in your suites.
# Map them in `prompt-guard.config.json` under the "env" key.
API_VERSION=2024-01-01
