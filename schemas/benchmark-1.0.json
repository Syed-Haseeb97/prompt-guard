{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prompt-guard.dev/schemas/benchmark-1.0.json",
  "title": "prompt-guard benchmark",
  "description": "A prompt-guard benchmark file (*.benchmark.json).",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "suites": { "type": "array", "items": { "type": "string" } },
    "providers": { "type": "object" },
    "defaultProvider": { "type": "string" },
    "model": { "type": "string" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxFailures": { "type": "integer", "minimum": 0 },
        "maxErrors": { "type": "integer", "minimum": 0 },
        "maxRegressions": { "type": "integer", "minimum": 0 },
        "byTag": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxDurationMs": { "type": "integer", "minimum": 1 },
        "maxCaseDurationMs": { "type": "integer", "minimum": 1 }
      }
    },
    "requiredTags": { "type": "array", "items": { "type": "string" } }
  }
}
