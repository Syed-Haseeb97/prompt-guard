{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prompt-guard.dev/schemas/suite-1.0.json",
  "title": "prompt-guard suite",
  "description": "A prompt-guard suite file (*.suite.json).",
  "type": "object",
  "required": ["name", "fixtures"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "integer" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "defaults": { "$ref": "#/definitions/defaults" },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/definitions/fixture" }
    }
  },
  "definitions": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assertions": { "type": "array", "items": { "$ref": "#/definitions/assertion" } },
        "provider": { "type": "object" },
        "model": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "retries": { "type": "integer", "minimum": 0 },
        "system": { "type": "string" }
      }
    },
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "additionalProperties": false,
      "properties": {
        "role": { "enum": ["system", "user", "assistant", "tool"] },
        "content": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "fixture": {
      "type": "object",
      "required": ["id", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "system": { "type": "string" },
        "prompt": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "$ref": "#/definitions/message" } }
          ]
        },
        "variables": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "assertions": { "type": "array", "items": { "$ref": "#/definitions/assertion" } },
        "provider": { "type": "object" },
        "model": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "retries": { "type": "integer", "minimum": 0 },
        "metadata": { "type": "object" },
        "skip": { "type": "boolean" },
        "mockResponse": { "type": "string" },
        "frozenOutput": { "type": "string" },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "promptHash": { "type": "string" },
            "model": { "type": "string" }
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["semantic", "regex", "jsonSchema", "keywords", "contains", "length", "custom"]
        },
        "name": { "type": "string" },
        "severity": { "enum": ["error", "warn"] },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
