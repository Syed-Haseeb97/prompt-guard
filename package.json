{
  "name": "prompt-guard",
  "version": "1.0.0",
  "description": "Regression testing and guardrails for LLM prompts. Fuzzy assertion engines, side-by-side diffs, and JSON run reports.",
  "keywords": [
    "llm",
    "prompt",
    "regression-testing",
    "evals",
    "eval",
    "guardrails",
    "cli",
    "testing"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "bin": {
    "prompt-guard": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
